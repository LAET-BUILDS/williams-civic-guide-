{
  "name": "williams-civic-guide",
  "version": "0.3.0",
  "private": true,
  "description": "Unofficial civic education site for Williams, CA: how to read a city rule and check it against state and federal law (prototype, not deployed)",
  "scripts": {
    "build": "node build.js",
    "serve": "python3 -m http.server 8080 --directory dist",
    "test:a11y": "node tools/a11y-check.js",
    "check:links": "node tools/check-links.js",
    "test:smoke": "node tools/smoke-test.js",
    "check:overflow": "node tools/overflow-check.js",
    "check:es-review": "REQUIRE_ES_REVIEW=1 node build.js"
  },
  "license": "CC0-1.0",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "puppeteer-core": "^24.43.1"
  }
}
